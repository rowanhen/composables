#!/usr/bin/env sh
set -e

echo "Running oxlint..."
bun run lint

echo "Running oxfmt check..."
bunx oxfmt --check .

echo "Running typecheck..."
bun run typecheck

echo "Verifying generated palette CSS..."
bun scripts/generate-tokens.ts --check


echo "Verifying generated AI rules and skill manifests..."
bun run test:rules

echo "Checking semantic token system..."
bun run test:tokens
