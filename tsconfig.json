{
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node", "bun"],
		"baseUrl": ".",
		"paths": {
			"@/components/_internal/*": ["src/_internal/*"],
			"@/components/ai-elements/*": ["src/_internal/ai-elements/*"],
			"@/components/ui-opinionated/*": ["src/opinionated/*"],
			"@/lib/*": ["src/lib/*"],
			"@/hooks/*": ["src/hooks/*"],
			"@/*": ["showcase/src/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": [
		"src",
		"showcase/src",
		".storybook",
		"showcase/vite.config.ts",
		"scripts/generate*.ts",
		"scripts/check-token-system.ts",
		"scripts/lint-tokens.ts",
		"scripts/token-system.test.ts",
		"scripts/validate-tokens.ts",
		"scripts/token-browser.test.ts",
		"scripts/build-css.ts",
		"scripts/test-downstream-css.ts"
	]
}
