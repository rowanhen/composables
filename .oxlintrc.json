{
	"plugins": ["react", "typescript"],
	"rules": {
		"no-unused-vars": "error",
		"react/no-unknown-property": "off"
	},
	"ignorePatterns": ["dist", "node_modules"],
	"jsPlugins": [
		{
			"name": "composables",
			"specifier": "./src/lint/index.ts"
		}
	],
	"overrides": [
		{
			"files": [
				"showcase/src/**/*.{ts,tsx}",
				"src/opinionated/**/*.stories.tsx",
				"src/_storybook/**/*.stories.tsx"
			],
			"rules": {
				"composables/use-opinionated-components": "error",
				"composables/use-semantic-tokens": "error"
			}
		},
		{
			"files": ["src/opinionated/**/{avatar,card,item,progress}.stories.tsx"],
			"rules": {
				"composables/use-opinionated-components": "off"
			}
		},
		{
			"files": ["showcase/src/tools/token-config-panel/**/*"],
			"rules": {
				"composables/use-opinionated-components": "off",
				"composables/use-semantic-tokens": "off"
			}
		}
	]
}
