{
	"name": "@leitware/composables",
	"version": "0.1.1",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/rowanhen/composables"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.stories.tsx",
		"!src/_storybook"
	],
	"imports": {
		"#styles/*": "./src/styles/*"
	},
	"exports": {
		".": "./src/index.ts",
		"./eslint-plugin": "./dist/eslint-plugin.mjs",
		"./styles.css": "./dist/styles.css",
		"./tailwind.css": "./dist/tailwind.css",
		"./presets/*": "./dist/presets/*"
	},
	"scripts": {
		"dev": "storybook dev -p 6006",
		"lint": "bun --bun oxlint",
		"knip": "knip",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"typecheck": "tsc --noEmit",
		"hooks:install": "git config core.hooksPath .githooks",
		"build:css": "bun scripts/build-css.ts",
		"build:lint": "bun build src/lint/index.ts --target=node --outfile=dist/eslint-plugin.mjs",
		"prepack": "bun run build:css && bun run build:lint",
		"test": "bun test",
		"test:tokens": "bun scripts/check-token-system.ts",
		"test:css": "bun scripts/test-downstream-css.ts",
		"deploy:showcase": "./scripts/deploy-showcase.sh",
		"build:storybook": "storybook build -o showcase/dist && bun scripts/prepare-storybook.ts"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-react": "^1.23.0",
		"tailwind-merge": "^3.6.0",
		"@ui-sdk/core": "0.1.0-beta.9",
		"@ui-sdk/react": "0.1.0-beta.9"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"@fontsource-variable/inter": "^5.0.0",
		"@fontsource-variable/geist": "^5.0.0",
		"@fontsource-variable/bricolage-grotesque": "^5.0.0",
		"@fontsource-variable/dm-sans": "^5.0.0",
		"@fontsource-variable/fraunces": "^5.0.0",
		"@fontsource-variable/source-serif-4": "^5.0.0",
		"@fontsource-variable/space-grotesk": "^5.0.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.0.0",
		"@fontsource-variable/jetbrains-mono": "^5.0.0",
		"@fontsource/ibm-plex-mono": "^5.0.0",
		"@fontsource/ibm-plex-sans": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@fontsource-variable/inter": {
			"optional": true
		},
		"@fontsource-variable/geist": {
			"optional": true
		},
		"@fontsource-variable/bricolage-grotesque": {
			"optional": true
		},
		"@fontsource-variable/dm-sans": {
			"optional": true
		},
		"@fontsource-variable/fraunces": {
			"optional": true
		},
		"@fontsource-variable/source-serif-4": {
			"optional": true
		},
		"@fontsource-variable/space-grotesk": {
			"optional": true
		},
		"@fontsource-variable/plus-jakarta-sans": {
			"optional": true
		},
		"@fontsource-variable/jetbrains-mono": {
			"optional": true
		},
		"@fontsource/ibm-plex-mono": {
			"optional": true
		},
		"@fontsource/ibm-plex-sans": {
			"optional": true
		}
	},
	"devDependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.2.10",
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/fraunces": "^5.2.9",
		"@fontsource-variable/geist": "^5.0.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/plus-jakarta-sans": "^5.2.8",
		"@fontsource-variable/source-serif-4": "^5.2.9",
		"@fontsource-variable/space-grotesk": "^5.2.10",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-links": "^10.6.2",
		"@storybook/react-vite": "^10.6.2",
		"@tailwindcss/cli": "^4.3.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"knip": "^6.47.0",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"shadcn": "^4.13.0",
		"storybook": "^10.6.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.3",
		"wrangler": "^4.107.0"
	}
}
